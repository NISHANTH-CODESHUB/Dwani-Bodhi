{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix apps/web ci",
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{services/api/app/**,services/api/migrations/**,services/api/alembic.ini,content/**}"
    }
  },
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api/index?__vp=/v1/:path*" },
    { "source": "/health", "destination": "/api/index?__vp=/health" },
    { "source": "/((?!assets/|icons/|audio/|api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(sw.js|registerSW.js|index.html|manifest.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "crons": [{ "path": "/v1/cron/tick", "schedule": "30 21 * * *" }]
}
