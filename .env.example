# Copy to .env and fill in. NEVER commit .env.
APP_ENV=dev
# Postgres in production (docker-compose builds DATABASE_URL from POSTGRES_PASSWORD); SQLite by default in dev.
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql+psycopg://dhwani:change-me@localhost:5432/dhwani

JWT_SECRET=generate-with-python-secrets-token_urlsafe-48
PHONE_PEPPER=another-long-random-secret
CORS_ORIGINS=*
# Caddy obtains TLS automatically for a real domain
SITE_ADDRESS=your-domain.example

# Claude (optional: without a key the system runs in offline mode — template cards, teacher-read slates)
ANTHROPIC_API_KEY=
LLM_MODE=auto
MODEL_SLATE=claude-sonnet-5-5
MODEL_CARD=claude-opus-5-5
MODEL_EXPLAIN=claude-opus-5-5
MODEL_HYPOTHESIS=claude-opus-5-5
DAILY_LLM_BUDGET_USD=5

# Speech: "wav2vec2" for real scoring (needs the speech extra), "simulated" for demos/tests only
SPEECH_BACKEND=simulated
# Open (MIT) EkStep Vakyansh Hindi model. Alternative: ai4bharat/indicwav2vec-hindi (gated: accept terms on
# Hugging Face and set HF_TOKEN).
SPEECH_MODEL_ID=Harveenchadha/vakyansh-wav2vec2-hindi-him-4200
# HF_TOKEN=
ALLOW_SIMULATED_AUDIO=true
# ECCL_CALIBRATION=/app/eval/calibration.json

# Storage: local disk or S3-compatible (keep the bucket in an Indian region)
BLOB_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT=
AUDIO_RETENTION_HOURS=0
# Per-child slate answer crops (for the teacher confirm queue); full classroom photos are deleted after cropping
SLATE_CROP_RETENTION_DAYS=30
MIN_CELL_SIZE=5
# Create account as admin: active at once (admins above are notified). false = needs approval.
ADMIN_SELF_SIGNUP=true
