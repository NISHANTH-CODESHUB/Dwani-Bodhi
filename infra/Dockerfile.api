# API + worker image. Build arg SPEECH=1 adds PyTorch + transformers for speech workers.
FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY services/api/pyproject.toml services/api/pyproject.toml
COPY services/api/app services/api/app
ARG SPEECH=0
RUN pip install -e "services/api[s3]" \
    && if [ "$SPEECH" = "1" ]; then pip install --index-url https://download.pytorch.org/whl/cpu torch \
       && pip install "transformers>=4.41"; fi
COPY services/api/migrations services/api/migrations
COPY services/api/alembic.ini services/api/alembic.ini
COPY content content
RUN useradd -m app && mkdir -p /data && chown app /data
USER app
WORKDIR /app/services/api
ENV CONTENT_PACK_DIR=/app/content/packs/hi-IN BLOB_DIR=/data/blobs
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD curl -fsS http://localhost:8000/health || exit 1
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${API_WORKERS:-2} --proxy-headers"]
